---
import SectionHeading from '../ui/SectionHeading.astro';
import { site } from '../../config/site';
---

<section id="process" aria-labelledby="process-title" class="relative isolate border-t border-glass-border py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading id="process-title">
      {site.processTitle}
      <Fragment slot="lead">{site.processLead}</Fragment>
    </SectionHeading>

    <!-- Vertical timeline on mobile, horizontal from md up -->
    <ol class="relative mt-16 grid gap-10 md:grid-cols-5 md:gap-6" data-reveal-group>
      <span
        aria-hidden="true"
        class="absolute top-5 bottom-5 left-5 w-px md:top-5 md:right-[calc(20%-2.4rem)] md:bottom-auto md:left-5 md:h-px md:w-auto"
        style="background: var(--gradient-brand); opacity: 0.55"
      ></span>
      {
        site.process.map((step, i) => (
          <li class="relative flex gap-5 md:flex-col md:gap-6" data-reveal>
            <span class="relative z-10 grid size-10 shrink-0 place-items-center rounded-full border border-glass-border-strong bg-ink-950 font-display text-base font-extrabold text-fg">
              {i + 1}
            </span>
            <div class="pt-1.5 md:pt-0">
              <h3 class="text-lg font-bold">{step.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-fg-muted">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
