---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../config/site';
---

<Base title={`Page not found | ${site.name}`} noindex>
  <Nav />
  <main id="main" class="relative isolate grid min-h-dvh place-items-center px-4 pt-(--nav-height)">
    <div class="edge-glow -top-56 -left-56 size-[36rem] bg-magenta/16"></div>
    <div class="max-w-xl text-center">
      <p class="font-display text-8xl font-black tracking-[-0.04em] text-fg-subtle">404</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-[-0.03em]">This page wandered off into the outback.</h1>
      <p class="mt-4 text-fg-muted">The link may be old, or the page may have moved. Head home, or ask us in the Discord.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button url="/" size="lg" arrow>Back to home</Button>
        <Button url={site.discordUrl} size="lg" variant="ghost" icon="discord">Join the Discord</Button>
      </div>
    </div>
  </main>
</Base>
