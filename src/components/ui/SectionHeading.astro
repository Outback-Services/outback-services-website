---
/**
 * Section H2 + optional lead. Headings are solid text; the section's product
 * color (set with tone-fivem / tone-bots / tone-wally on an ancestor) shows
 * only as a short rule mark beside the heading.
 */
interface Props {
  id?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { id, align = 'left', class: className = '' } = Astro.props;
---

<div class:list={[align === 'center' && 'mx-auto text-center', 'max-w-3xl', className]} data-reveal>
  <h2 id={id} class="text-4xl leading-[1.05] font-extrabold sm:text-5xl">
    <slot />
  </h2>
  <span
    aria-hidden="true"
    class:list={['mt-5 block h-1 w-12 rounded-full', align === 'center' && 'mx-auto']}
    style="background: var(--accent, var(--color-violet))"
  ></span>
  {
    Astro.slots.has('lead') && (
      <p class="mt-5 max-w-[62ch] text-lg text-fg-muted">
        <slot name="lead" />
      </p>
    )
  }
</div>
