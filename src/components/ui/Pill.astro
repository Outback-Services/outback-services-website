---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  icon?: IconName;
  tone?: 'default' | 'accent';
  class?: string;
}
const { icon, tone = 'default', class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold tracking-wide',
    tone === 'accent'
      ? 'border-glass-border-strong bg-glass-strong text-fg'
      : 'border-glass-border bg-glass text-fg-muted',
    className,
  ]}
>
  {icon && <Icon name={icon} class="size-3.5 text-cyan" />}
  <slot />
</span>
