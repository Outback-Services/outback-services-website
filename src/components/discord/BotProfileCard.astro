---
/** Faux Discord bot profile popout for Wally. Decorative: hidden from AT. */
import WallyAvatar from '../ui/WallyAvatar.astro';
import { site } from '../../config/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={['w-64 overflow-hidden rounded-panel border border-glass-border bg-ink-800 shadow-panel select-none', className]}
>
  <div class="h-14 opacity-85" style="background: var(--gradient-brand)"></div>
  <div class="px-4 pb-4">
    <span class="relative -mt-8 block size-16 rounded-full bg-ink-800 p-1">
      <WallyAvatar compact decorative sizes="64px" class="size-full" />
      <span class="absolute right-0.5 bottom-0.5 size-4 rounded-full border-[3px] border-ink-800 bg-online"></span>
    </span>
    <p class="mt-2 flex items-center gap-1.5 text-base font-bold text-fg">
      Wally
      <span class="inline-flex items-center gap-0.5 rounded-[4px] bg-blurple px-1 py-px text-[10px] leading-tight font-semibold text-white">
        <svg viewBox="0 0 16 16" class="size-2.5"><path fill="currentColor" d="M6.2 11.6 2.6 8l1.1-1.1 2.5 2.5 6.1-6.1 1.1 1.1z"></path></svg>
        BOT
      </span>
    </p>
    <p class="text-xs text-fg-subtle">Online</p>
    <div class="mt-3 rounded-[4px] bg-ink-950/60 p-3">
      <p class="text-[11px] font-semibold text-fg-muted">About me</p>
      <p class="mt-1 text-xs leading-relaxed text-fg-muted">{site.wallyAbout}</p>
    </div>
  </div>
</div>
