---
import Icon from '../ui/Icon.astro';
import Wordmark from '../ui/Wordmark.astro';
import { site } from '../../config/site';
import { externalAttrs } from '../../lib/links';

const elsewhere = [
  { label: 'Discord', url: site.discordUrl, icon: 'discord' as const },
  { label: 'Tebex store', url: site.tebexUrl, icon: 'store' as const },
  { label: 'GitHub', url: site.githubUrl, icon: 'github' as const },
  { label: 'Add Wally', url: site.wallyInviteUrl, icon: 'bot' as const },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-glass-border">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
    <div>
      <a href="/" class="text-xl" aria-label={`${site.name} home`}><Wordmark /></a>
      <p class="mt-3 max-w-[36ch] text-sm text-fg-muted">{site.tagline}.</p>
    </div>

    <nav aria-label="Footer">
      <p class="text-sm font-semibold text-fg">On this page</p>
      <ul class="mt-4 space-y-2.5" role="list">
        {
          site.nav.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-fg-muted transition-colors hover:text-fg">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="text-sm font-semibold text-fg">Find us</p>
      <ul class="mt-4 space-y-2.5" role="list">
        {
          elsewhere.map((l) => (
            <li>
              <a {...externalAttrs(l.url)} class="inline-flex items-center gap-2 text-sm text-fg-muted transition-colors hover:text-fg">
                <Icon name={l.icon} class="size-4" />
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-glass-border">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-7 text-xs text-fg-subtle sm:px-6 md:flex-row md:justify-between lg:px-8">
      <p>© {year} {site.name}</p>
      <p class="max-w-[70ch]">{site.footer.disclaimer}</p>
    </div>
  </div>
</footer>
