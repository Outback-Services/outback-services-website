---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import FiveM from '../components/sections/FiveM.astro';
import DiscordBots from '../components/sections/DiscordBots.astro';
import Wally from '../components/sections/Wally.astro';
import Standards from '../components/sections/Standards.astro';
import Process from '../components/sections/Process.astro';
import Founder from '../components/sections/Founder.astro';
import Work from '../components/sections/Work.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { site } from '../config/site';

// FAQPage structured data (plain-text answers; the refund link token becomes text).
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: site.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a.replace('{tebexRefundPolicyUrl}', 'refund policy') },
  })),
};
---

<Base jsonLd={[faqJsonLd]}>
  <Nav />
  <main id="main">
    <Hero />
    <FiveM />
    <DiscordBots />
    <Wally />
    <Standards />
    <Process />
    <Founder />
    <Work />
    <Faq />
    <FinalCta />
  </main>
</Base>
