---
/**
 * Hand-drawn neon swoosh under key words. Draws on once at load
 * (stroke-dashoffset, as briefed); reduced motion shows it fully drawn.
 */
interface Props {
  class?: string;
  /** Delay before the stroke draws, in ms. */
  delay?: number;
}
const { class: className = '', delay = 250 } = Astro.props;
const id = `nu-${Math.random().toString(36).slice(2, 8)}`;
---

<span class:list={['relative inline-block whitespace-nowrap', className]}>
  <slot />
  <svg
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 300 24"
    preserveAspectRatio="none"
    class="pointer-events-none absolute -bottom-[0.18em] left-[-2%] h-[0.32em] w-[104%] overflow-visible"
  >
    <defs>
      <linearGradient id={id} x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" style="stop-color: var(--color-magenta)"></stop>
        <stop offset="0.5" style="stop-color: var(--color-violet)"></stop>
        <stop offset="1" style="stop-color: var(--color-cyan)"></stop>
      </linearGradient>
    </defs>
    <path
      d="M3 17C58 8 129 4 206 7c34 1.3 63 4.4 91 9"
      pathLength="1"
      fill="none"
      stroke={`url(#${id})`}
      stroke-width="5"
      stroke-linecap="round"
      class="motion-safe:animate-draw"
      style={`stroke-dasharray: 1; --dash: 1; animation-delay: ${delay}ms; filter: drop-shadow(0 0 6px color-mix(in oklab, var(--color-violet) 70%, transparent));`}
    ></path>
  </svg>
</span>
