---
import Button from '../ui/Button.astro';
import Sparkle from '../ui/Sparkle.astro';
import { site } from '../../config/site';
---

<section aria-labelledby="final-title" data-anim-scope class="relative isolate overflow-hidden border-t border-glass-border py-28 sm:py-36">
  <div
    aria-hidden="true"
    class="absolute -bottom-72 left-1/2 -z-10 h-[34rem] w-[64rem] -translate-x-1/2 rounded-full opacity-35 blur-[110px]"
    style="background: var(--gradient-brand)"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8" data-reveal>
    <Sparkle class="absolute -top-6 left-[12%] size-5" color="text-cyan" />
    <Sparkle class="absolute top-10 right-[10%] size-3.5" color="text-magenta" delay={1100} />
    <h2 id="final-title" class="text-4xl leading-[1.03] font-extrabold tracking-[-0.03em] sm:text-6xl">{site.finalCta.title}</h2>
    <p class="mx-auto mt-6 max-w-[46ch] text-lg text-fg-muted">{site.finalCta.body}</p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <Button url={site.discordUrl} size="lg" icon="discord" arrow magnetic>Join the Discord</Button>
      <Button url={site.tebexUrl} size="lg" variant="ghost">Browse scripts</Button>
    </div>
  </div>
</section>
